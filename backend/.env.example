# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com

# Models are settings because Google renames/retires them often.
# Check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated list of sites allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,https://kuldeep-soni-showcase.vercel.app

RATE_LIMIT=20/minute
TOP_K=5
